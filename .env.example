# PostgreSQL connection string (required)
DATABASE_URL=postgres://almanach:change-me@db:5432/almanach

# HTTP listener
PORT=8080
HOST=0.0.0.0

# Set to false only when serving over plain HTTP on a trusted local network
COOKIE_SECURE=true

# Set to true when Almanach runs behind a reverse proxy (Caddy, Traefik, nginx)
TRUST_PROXY=false

# Optional: preset the installation token (32+ characters) for automated deployments.
# When empty, a random token is printed in the logs at first start.
ALMANACH_INSTALL_TOKEN=

# Used by docker-compose for the database container
POSTGRES_PASSWORD=change-me

# E-mail for reminders (optional). Secrets stay in the environment, never in the database.
# Example: smtps://almanach%40example.com:app-password@mail.example.com:465
SMTP_URL=
SMTP_FROM="Almanach <almanach@example.com>"

# Background reminders (deadlines, late invoices, thresholds), checked every 10 minutes
REMINDERS=true

# Signed country pack updates (optional). Comma-separated raw Ed25519 public keys (base64url).
# Without keys, only the packs shipped with Almanach are used.
PACK_PUBLIC_KEYS=
# HTTPS folder with index.json and signed bundles, checked daily once an administrator turns it on in Settings
PACK_UPDATE_URL=

# Serve only the maintenance page (for example while restoring a backup)
MAINTENANCE=false

# Asked once a day for the latest release, only when an administrator turns the check on in Settings
# RELEASE_CHECK_URL=https://api.github.com/repos/chteau/almanach/releases/latest
